{
  "manifest_version": 3,
  "name": "No Contributions",
  "version": "1.1.0",
  "description": "Reduces social-comparison distractions on GitHub and LinkedIn.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["config.js", "routing.js", "github.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://linkedin.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["config.js", "routing.js", "linkedin.js"],
      "run_at": "document_start"
    }
  ]
}
