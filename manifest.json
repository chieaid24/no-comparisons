{
  "manifest_version": 3,
  "name": "no-comparisons",
  "version": "1.3.0",
  "description": "Reduces social-comparison distractions on GitHub and LinkedIn.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "no-comparisons"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "config.js",
        "settings.js",
        "routing.js",
        "toast.js",
        "dom.js",
        "content.js",
        "github.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://linkedin.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "config.js",
        "settings.js",
        "routing.js",
        "toast.js",
        "dom.js",
        "linkedin-dom.js",
        "linkedin.js"
      ],
      "run_at": "document_start"
    }
  ]
}
